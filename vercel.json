{
  "version": 2,
  "public": false,
  "github": {
    "enabled": false
  },
  "buildCommand": "",
  "outputDirectory": ".",
  "devCommand": null,
  "installCommand": "",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.sentry.io https://vercel.live; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api-ihf-rules-questions.azurewebsites.net https://*.sentry.io https://vercel.live; frame-src https://vercel.live; img-src 'self' data: https:; font-src 'self' data:; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/ngsw-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ngsw.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
