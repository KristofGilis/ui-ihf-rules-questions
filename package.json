{
  "name": "ui-ihf-rules-questions",
  "version": "2.1.3",
  "description": "Interactive quiz application for testing knowledge of International Handball Federation (IHF) rules",
  "author": "Kristof Gilis <kristof.gilis@outlook.be>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KristofGilis/ui-ihf-rules-questions.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:web": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "generate": "graphql-codegen",
    "i18n:init": "ngx-translate-extract --input ./src --output ./public/i18n/template.json --key-as-default-value --replace --format json --format-indentation \"  \"",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --format namespaced-json --format-indentation \"  \" --sort",
    "i18n:clean": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --clean --format namespaced-json --format-indentation \"  \" --sort",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "lint": "npx ng lint",
    "lint:fix": "npx ng lint --fix",
    "bundle:analyze": "ng build --configuration production --named-chunks --stats-json && npx esbuild-visualizer --metadata dist/ui-ihf-rules-questions/stats.json --open",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "http-server dist/ui-ihf-rules-questions/browser -p 4200 -c-1 --proxy http://localhost:4200?",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.0.0",
    "@angular/common": "~21.0.0",
    "@angular/compiler": "~21.0.0",
    "@angular/core": "~21.0.0",
    "@angular/forms": "~21.0.0",
    "@angular/platform-browser": "~21.0.0",
    "@angular/platform-browser-dynamic": "~21.0.0",
    "@angular/platform-server": "~21.0.0",
    "@angular/router": "~21.0.0",
    "@angular/service-worker": "~21.0.0",
    "@apollo/client": "~4.0.0",
    "@fortawesome/angular-fontawesome": "~3.0.0",
    "@fortawesome/fontawesome-svg-core": "~7.1.0",
    "@fortawesome/free-brands-svg-icons": "~7.1.0",
    "@fortawesome/free-solid-svg-icons": "~7.1.0",
    "@ngx-translate/core": "~17.0.0",
    "@ngx-translate/http-loader": "~17.0.0",
    "@sentry/angular": "~10.27.0",
    "apollo-angular": "~13.0.0",
    "graphql": "~16.12.0",
    "hammerjs": "~2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "~2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "~20.0.0",
    "@angular-eslint/builder": "~21.0.0",
    "@angular-eslint/eslint-plugin": "~21.0.0",
    "@angular-eslint/eslint-plugin-template": "~21.0.0",
    "@angular-eslint/schematics": "~21.0.0",
    "@angular-eslint/template-parser": "~21.0.0",
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~21.0.0",
    "@axe-core/playwright": "~4.11.0",
    "@biesbjerg/ngx-translate-extract-marker": "~1.0.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@graphql-codegen/cli": "~6.1.0",
    "@graphql-codegen/typescript": "~5.0.0",
    "@graphql-codegen/typescript-apollo-angular": "~4.0.0",
    "@graphql-codegen/typescript-operations": "~5.0.0",
    "@playwright/test": "~1.57.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/postcss": "~4.1.0",
    "@tailwindcss/vite": "~4.1.0",
    "@types/hammerjs": "~2.0.0",
    "@types/jest": "~30.0.0",
    "@types/node": "~24.10.0",
    "@typescript-eslint/eslint-plugin": "~8.48.0",
    "@typescript-eslint/parser": "~8.48.0",
    "@vendure/ngx-translate-extract": "~10.1.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "~9.39.0",
    "http-server": "~14.1.0",
    "husky": "^9.1.7",
    "jest": "~30.2.0",
    "jest-preset-angular": "~15.0.0",
    "prettier": "~3.7.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "semantic-release": "^25.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "~4.1.0",
    "typescript": "~5.9.0"
  }
}
