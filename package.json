{
  "name": "ui-ihf-rules-questions",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/ui-ihf-rules-questions/server/server.mjs",
    "generate": "graphql-codegen",
    "i18n:init": "ngx-translate-extract --input ./src --output ./public/i18n/template.json --key-as-default-value --replace --format json --format-indentation \"  \"",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --format namespaced-json --format-indentation \"  \" --sort",
    "i18n:clean": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --clean --format namespaced-json --format-indentation \"  \" --sort"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.4",
    "@angular/cdk": "^18.0.4",
    "@angular/common": "^18.0.4",
    "@angular/compiler": "^18.0.4",
    "@angular/core": "^18.0.4",
    "@angular/forms": "^18.0.4",
    "@angular/material": "^18.0.4",
    "@angular/platform-browser": "^18.0.4",
    "@angular/platform-browser-dynamic": "^18.0.4",
    "@angular/platform-server": "^18.0.4",
    "@angular/router": "^18.0.4",
    "@angular/service-worker": "^18.0.4",
    "@angular/ssr": "^18.0.5",
    "@apollo/client": "^3.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "apollo-angular": "^7.0.2",
    "bootstrap": "^5.3.3",
    "express": "^4.18.2",
    "graphql": "^16.8.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.5",
    "@angular/cli": "^18.0.5",
    "@angular/compiler-cli": "^18.0.4",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.7",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.2.1",
    "@types/express": "^4.17.17",
    "@types/node": "^18.18.0",
    "@vendure/ngx-translate-extract": "^9.2.0",
    "typescript": "~5.4.2"
  }
}