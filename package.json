{
  "name": "ui-ihf-rules-questions",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "generate": "graphql-codegen",
    "i18n:init": "ngx-translate-extract --input ./src --output ./public/i18n/template.json --key-as-default-value --replace --format json --format-indentation \"  \"",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --format namespaced-json --format-indentation \"  \" --sort",
    "i18n:clean": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --clean --format namespaced-json --format-indentation \"  \" --sort",
    "serve:ssr:ui-ihf-rules-questions": "node dist/ui-ihf-rules-questions/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/service-worker": "^20.0.0",
    "@apollo/client": "^3.13.8",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "apollo-angular": "^10.0.3",
    "bootstrap": "^5.3.5",
    "graphql": "^16.11.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.6.0",
    "@types/node": "^22.15.3",
    "@vendure/ngx-translate-extract": "^9.4.0",
    "typescript": "~5.8.3"
  }
}
