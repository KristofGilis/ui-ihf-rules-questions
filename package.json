{
  "name": "ui-ihf-rules-questions",
  "version": "0.0.0",
  "description": "Interactive quiz application for testing knowledge of International Handball Federation (IHF) rules",
  "author": "Kristof Gilis <kristof.gilis@outlook.be>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KristofGilis/ui-ihf-rules-questions.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:web": "ng build --configuration production",
    "preview": "ng build --configuration production && npx http-server dist/ui-ihf-rules-questions/browser -p 4200 -c-1 -P http://localhost:4200?",
    "watch": "ng build --watch --configuration development",
    "codegen": "graphql-codegen && node scripts/inject-schema-version.mjs",
    "i18n:init": "ngx-translate-extract --input ./src --output ./public/i18n/template.json --key-as-default-value --replace --format json --format-indentation \"  \"",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --output ./public/i18n/fr.json --format namespaced-json --format-indentation \"  \" --sort",
    "i18n:clean": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --output ./public/i18n/fr.json --clean --format namespaced-json --format-indentation \"  \" --sort",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "lint": "npx ng lint",
    "lint:fix": "npx ng lint --fix",
    "bundle:analyze": "ng build --configuration production --named-chunks --stats-json && npx esbuild-visualizer --metadata dist/ui-ihf-rules-questions/stats.json --open",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.0.0",
    "@angular/compiler": "~22.0.0",
    "@angular/core": "~22.0.0",
    "@angular/forms": "~22.0.0",
    "@angular/platform-browser": "~22.0.0",
    "@angular/platform-server": "~22.0.0",
    "@angular/router": "~22.0.0",
    "@angular/service-worker": "~22.0.0",
    "@apollo/client": "~4.2.0",
    "@fortawesome/angular-fontawesome": "~5.0.0",
    "@fortawesome/fontawesome-svg-core": "~7.2.0",
    "@fortawesome/free-brands-svg-icons": "~7.2.0",
    "@fortawesome/free-solid-svg-icons": "~7.2.0",
    "@ngx-translate/core": "~18.0.0",
    "@ngx-translate/http-loader": "~18.0.0",
    "apollo-angular": "~14.1.0",
    "apollo4-cache-persist": "^1.0.11",
    "graphql": "~16.14.0",
    "hammerjs": "~2.0.0",
    "localforage": "^1.10.0",
    "rxjs": "~7.8.0",
    "tslib": "~2.8.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "~22.0.0",
    "@angular-eslint/eslint-plugin": "~22.0.0",
    "@angular-eslint/eslint-plugin-template": "~22.0.0",
    "@angular-eslint/schematics": "~22.0.0",
    "@angular-eslint/template-parser": "~22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "~22.0.0",
    "@angular/compiler-cli": "~22.0.0",
    "@biesbjerg/ngx-translate-extract-marker": "~1.0.0",
    "@commitlint/cli": "~21.1.0",
    "@commitlint/config-conventional": "~21.1.0",
    "@graphql-codegen/cli": "~7.1.0",
    "@graphql-codegen/typescript": "~6.0.0",
    "@graphql-codegen/typescript-apollo-angular": "~5.0.0",
    "@graphql-codegen/typescript-operations": "~6.0.0",
    "@tailwindcss/postcss": "~4.3.0",
    "@tailwindcss/vite": "~4.3.0",
    "@testing-library/angular": "~19.4.0",
    "@testing-library/user-event": "~14.6.1",
    "@types/hammerjs": "~2.0.0",
    "@types/node": "~24.13.0",
    "@typescript-eslint/eslint-plugin": "~8.62.0",
    "@typescript-eslint/parser": "~8.62.0",
    "@vendure/ngx-translate-extract": "~10.2.0",
    "esbuild-visualizer": "~0.7.0",
    "eslint": "~10.5.0",
    "happy-dom": "~20.10.0",
    "http-server": "~14.1.0",
    "husky": "~9.1.7",
    "postcss": "^8.5.3",
    "prettier": "~3.8.0",
    "prettier-plugin-tailwindcss": "~0.8.0",
    "semantic-release": "~25.0.2",
    "sharp": "~0.35.0",
    "tailwindcss": "~4.3.0",
    "typescript": "~6.0.3"
  }
}
