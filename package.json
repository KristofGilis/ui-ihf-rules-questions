{
  "name": "ui-ihf-rules-questions",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:web": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "generate": "graphql-codegen",
    "i18n:init": "ngx-translate-extract --input ./src --output ./public/i18n/template.json --key-as-default-value --replace --format json --format-indentation \"  \"",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --format namespaced-json --format-indentation \"  \" --sort",
    "i18n:clean": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --output ./public/i18n/nl.json --output ./public/i18n/srb.json --clean --format namespaced-json --format-indentation \"  \" --sort",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "lint": "npx ng lint",
    "lint:fix": "npx ng lint --fix",
    "cap:init": "cap init \"IHF Rules Quiz\" net.rulequestions.ihf",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "build:android": "ng build --configuration production && cap sync android && cd android && ./gradlew assembleDebug",
    "build:ios": "ng build --configuration production && cap sync ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.3",
    "@angular/common": "^20.1.3",
    "@angular/compiler": "^20.1.3",
    "@angular/core": "^20.1.3",
    "@angular/forms": "^20.1.3",
    "@angular/platform-browser": "^20.1.3",
    "@angular/platform-browser-dynamic": "^20.1.3",
    "@angular/platform-server": "^20.1.3",
    "@angular/router": "^20.1.3",
    "@angular/service-worker": "^20.1.3",
    "@apollo/client": "^4.0.4",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.0.3",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "apollo-angular": "^12.0.0",
    "graphql": "^16.11.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.5.0",
    "@angular-eslint/eslint-plugin": "20.5.0",
    "@angular-eslint/eslint-plugin-template": "20.5.0",
    "@angular-eslint/schematics": "20.5.0",
    "@angular-eslint/template-parser": "20.5.0",
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.3",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@capacitor/cli": "^7.4.4",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vendure/ngx-translate-extract": "^10.0.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.0"
  }
}